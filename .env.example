# Copy to apps/web/.env.local for local dev (never commit .env.local).
# Vercel: add the same keys in Project Settings → Environment Variables (Production/Preview).

# Base Sepolia JSON-RPC (public endpoint OK for hackathon)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532

# Chainlink ETH/USD on Base Sepolia (override if feed rotates)
CHAINLINK_ETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1

# Public RPC (Vercel production) — apps/web/.env.example has full list
# NEXT_PUBLIC_AEGIS_RPC_URL=https://<your-app>.vercel.app/api/rpc

# Optional: Supabase for audit log (required for shared public dashboard)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: public API CORS / kill switch
# AEGIS_CORS_ORIGIN=*
# AEGIS_PUBLIC_RPC_ENABLED=true

# Optional: AI memo provider (post-policy only)
# OPENROUTER_API_KEY=

# D3 deploy only (local disk — never commit; used by scripts/aegis-d3-deploy-once.sh)
# DEPLOYER_PRIVATE_KEY=

# Contract verify on Basescan (multichain V2 — https://etherscan.io/apidashboard; chainId 84532)
# ETHERSCAN_API_KEY=
